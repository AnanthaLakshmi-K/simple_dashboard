@inherits LayoutComponentBase
@using Syncfusion.Blazor

<div class="app">
    <main class="app-main">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .app {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #f5f5f5;
    }

    .app-main {
        flex: 1;
        overflow-y: auto;
    }

    .content {
        padding: 0;
        width: 100%;
        height: 100%;
    }
</style>
