@using AIAssistantSalesOperationsDashboard.Models
@using Syncfusion.Blazor.Spreadsheet
@using Syncfusion.Blazor.Buttons
@using Syncfusion.XlsIO

<div class="spreadsheet-wrapper">
    <div class="spreadsheet-controls">
        <SfButton @onclick="ExportToExcelAsync" CssClass="e-success e-small">
            📥 Export to Excel
        </SfButton>
    </div>

    <SfSpreadsheet @ref="SpreadsheetRef" 
                   AllowOpen="false"
                   AllowSave="false"
                   ShowSheetTabs="false">
        <SpreadsheetSheets>
            <SpreadsheetSheet>
                <SpreadsheetRanges>
                    <SpreadsheetRange Address="A1" DataSource="@GetReportData()" StartCell="A1" />
                </SpreadsheetRanges>

                <SpreadsheetCellStyles>
                    <!-- Header styling -->
                    <SpreadsheetCellStyle Name="Header" BackColor="#1F4E78" FontColor="white" FontSize="12" Bold="true" TextAlign="Center" VerticalAlign="Center" />
                    
                    <!-- Total row styling -->
                    <SpreadsheetCellStyle Name="TotalRow" BackColor="#D9E1F2" FontSize="11" Bold="true" />
                    
                    <!-- Currency formatting -->
                    <SpreadsheetCellStyle Name="Currency" NumberFormat="$#,##0.00" />
                    
                    <!-- High value highlighting -->
                    <SpreadsheetCellStyle Name="HighValue" BackColor="#FFEB9C" NumberFormat="$#,##0.00" />
                </SpreadsheetCellStyles>
            </SpreadsheetSheet>
        </SpreadsheetSheets>
    </SfSpreadsheet>

    <div class="spreadsheet-summary">
        <h4>Summary Statistics</h4>
        <table class="summary-table">
            <tr>
                <td>Total Orders:</td>
                <td class="value">@Orders.Count</td>
            </tr>
            <tr>
                <td>Total Order Value:</td>
                <td class="value">@(Orders.Sum(o => o.OrderValue):C2)</td>
            </tr>
            <tr>
                <td>Total Forecast Value:</td>
                <td class="value">@(Orders.Sum(o => o.ForecastValue):C2)</td>
            </tr>
            <tr>
                <td>Average Order Value:</td>
                <td class="value">@(Orders.Count > 0 ? Orders.Average(o => o.OrderValue) : 0:C2)</td>
            </tr>
            <tr>
                <td>Maximum Order Value:</td>
                <td class="value">@(Orders.Max(o => (decimal?)o.OrderValue) ?? 0:C2)</td>
            </tr>
            <tr>
                <td>Variance (Forecast vs Actual):</td>
                <td class="value">@((Orders.Sum(o => o.ForecastValue) - Orders.Sum(o => o.OrderValue)):C2)</td>
            </tr>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<OrderRecord> Orders { get; set; } = new();

    private SfSpreadsheet? SpreadsheetRef;

    private List<ReportData> GetReportData()
    {
        var report = new List<ReportData>
        {
            // Header row
            new ReportData
            {
                OrderID = "Order ID",
                Customer = "Customer",
                Region = "Region",
                Status = "Status",
                OrderDate = "Order Date",
                DeliveryDate = "Delivery Date",
                SalesRep = "Sales Rep",
                OrderValue = "Order Value",
                ForecastValue = "Forecast Value",
                Variance = "Variance",
                IsHeader = true
            }
        };

        // Data rows
        foreach (var order in Orders)
        {
            report.Add(new ReportData
            {
                OrderID = order.OrderID,
                Customer = order.Customer,
                Region = order.Region,
                Status = order.Status,
                OrderDate = order.OrderDate.ToShortDateString(),
                DeliveryDate = order.DeliveryDate.ToShortDateString(),
                SalesRep = order.SalesRepresentative,
                OrderValue = $"${order.OrderValue:N2}",
                ForecastValue = $"${order.ForecastValue:N2}",
                Variance = $"${(order.ForecastValue - order.OrderValue):N2}",
                IsHeader = false
            });
        }

        // Total row
        if (Orders.Count > 0)
        {
            report.Add(new ReportData
            {
                OrderID = "TOTAL",
                Customer = "",
                Region = "",
                Status = "",
                OrderDate = "",
                DeliveryDate = "",
                SalesRep = "",
                OrderValue = $"${Orders.Sum(o => o.OrderValue):N2}",
                ForecastValue = $"${Orders.Sum(o => o.ForecastValue):N2}",
                Variance = $"${(Orders.Sum(o => o.ForecastValue) - Orders.Sum(o => o.OrderValue)):N2}",
                IsHeader = false,
                IsTotal = true
            });

            // Average row
            report.Add(new ReportData
            {
                OrderID = "AVERAGE",
                Customer = "",
                Region = "",
                Status = "",
                OrderDate = "",
                DeliveryDate = "",
                SalesRep = "",
                OrderValue = $"${Orders.Average(o => o.OrderValue):N2}",
                ForecastValue = $"${Orders.Average(o => o.ForecastValue):N2}",
                Variance = $"${(Orders.Sum(o => o.ForecastValue) - Orders.Sum(o => o.OrderValue)) / Orders.Count:N2}",
                IsHeader = false,
                IsTotal = true
            });
        }

        return report;
    }

    private async Task ExportToExcelAsync()
    {
        try
        {
            if (SpreadsheetRef == null)
                return;

            // Create workbook data
            var workbookData = new List<ReportData> { new ReportData { OrderID = "Order ID", Customer = "Customer", Region = "Region", Status = "Status", OrderDate = "Order Date", DeliveryDate = "Delivery Date", SalesRep = "Sales Rep", OrderValue = "Order Value", ForecastValue = "Forecast Value", Variance = "Variance", IsHeader = true } };
            workbookData.AddRange(GetReportData().Skip(1));

            // Note: In a production environment, you would use XlsIO or similar to create a proper Excel file
            // For now, we'll show an alert indicating the export functionality would be triggered
            Console.WriteLine($"Exporting {Orders.Count} orders to Excel");

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
    }

    // Helper class for report data
    private class ReportData
    {
        public string OrderID { get; set; } = string.Empty;
        public string Customer { get; set; } = string.Empty;
        public string Region { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string OrderDate { get; set; } = string.Empty;
        public string DeliveryDate { get; set; } = string.Empty;
        public string SalesRep { get; set; } = string.Empty;
        public string OrderValue { get; set; } = string.Empty;
        public string ForecastValue { get; set; } = string.Empty;
        public string Variance { get; set; } = string.Empty;
        public bool IsHeader { get; set; }
        public bool IsTotal { get; set; }
    }
}
